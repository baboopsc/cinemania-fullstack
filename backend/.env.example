# Kopyalayıp .env olarak kaydedin. .env dosyası GitHub'a YÜKLENMEZ.

# PostgreSQL bağlantısı (ör. Neon). Boş bırakırsanız yerel SQLite kullanılır.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# SQLite dosya yolu (DATABASE_URL yoksa kullanılır)
# SQLITE_PATH=database.sqlite

# Sunucu portu
PORT=3000

# İzin verilen frontend adresleri (virgülle ayırın). Boşsa her yere açık.
# CORS_ORIGIN=http://localhost:5173,https://cinemania-frontend.onrender.com
